#compdef browser-session

autoload -U is-at-least

_browser-session() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_browser-session_commands" \
"*::: :->browser-session" \
&& ret=0
    case $state in
    (browser-session)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:browser-session-command-$line[1]:"
        case $line[1] in
            (init)
_arguments "${_arguments_options[@]}" : \
'--out=[Artifact directory containing \`browser-session.json\`]:DIR:_files -/' \
'--format=[Output format]:FORMAT:(text json)' \
'--target=[Target URL or browser surface]:TEXT:_default' \
'--goal=[Session goal]:TEXT:_default' \
'--browser=[Optional browser/runtime label]:TEXT:_default' \
'--force[Overwrite an existing record]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(record-step)
_arguments "${_arguments_options[@]}" : \
'--out=[Artifact directory containing \`browser-session.json\`]:DIR:_files -/' \
'--format=[Output format]:FORMAT:(text json)' \
'--action=[Browser action performed]:TEXT:_default' \
'--expectation=[Optional expectation or observed result]:TEXT:_default' \
'--status=[Step status]:STATUS:(pass fail)' \
'*--artifact=[Optional screenshot/log/evidence artifact path. Repeat for multiple artifacts]:PATH:_files' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(verify)
_arguments "${_arguments_options[@]}" : \
'--out=[Artifact directory containing \`browser-session.json\`]:DIR:_files -/' \
'--format=[Output format]:FORMAT:(text json)' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(show)
_arguments "${_arguments_options[@]}" : \
'--out=[Artifact directory containing \`browser-session.json\`]:DIR:_files -/' \
'--format=[Output format]:FORMAT:(text json)' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':shell -- Shell to generate completion script for:(bash zsh)' \
&& ret=0
;;
        esac
    ;;
esac
}

(( $+functions[_browser-session_commands] )) ||
_browser-session_commands() {
    local commands; commands=(
'init:Create a browser-session evidence record' \
'record-step:Append one browser-session step and optional artifacts' \
'verify:Verify the session has passing evidence' \
'show:Print the current session record' \
'completion:Print shell completion script' \
    )
    _describe -t commands 'browser-session commands' commands "$@"
}
(( $+functions[_browser-session__subcmd__completion_commands] )) ||
_browser-session__subcmd__completion_commands() {
    local commands; commands=()
    _describe -t commands 'browser-session completion commands' commands "$@"
}
(( $+functions[_browser-session__subcmd__init_commands] )) ||
_browser-session__subcmd__init_commands() {
    local commands; commands=()
    _describe -t commands 'browser-session init commands' commands "$@"
}
(( $+functions[_browser-session__subcmd__record-step_commands] )) ||
_browser-session__subcmd__record-step_commands() {
    local commands; commands=()
    _describe -t commands 'browser-session record-step commands' commands "$@"
}
(( $+functions[_browser-session__subcmd__show_commands] )) ||
_browser-session__subcmd__show_commands() {
    local commands; commands=()
    _describe -t commands 'browser-session show commands' commands "$@"
}
(( $+functions[_browser-session__subcmd__verify_commands] )) ||
_browser-session__subcmd__verify_commands() {
    local commands; commands=()
    _describe -t commands 'browser-session verify commands' commands "$@"
}

if [ "$funcstack[1]" = "_browser-session" ]; then
    _browser-session "$@"
else
    compdef _browser-session browser-session
fi
