#compdef repo-retro

autoload -U is-at-least

_repo-retro() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_repo-retro_commands" \
"*::: :->repo-retro" \
&& ret=0
    case $state in
    (repo-retro)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:repo-retro-command-$line[1]:"
        case $line[1] in
            (report)
_arguments "${_arguments_options[@]}" : \
'--repo=[Git work tree to inspect]:REPO:_files -/' \
'--mode=[Review framing mode]:MODE:(personal team maintainer)' \
'--format=[Output format]:FORMAT:(json markdown)' \
'--since=[Start date for an open-ended window ending today (YYYY-MM-DD)]:SINCE:_default' \
'--days=[Rolling window length ending today]:DAYS:_default' \
'--from=[Fixed inclusive start date (YYYY-MM-DD). Requires --to]:FROM_DATE:_default' \
'--to=[Fixed inclusive end date (YYYY-MM-DD). Requires --from]:TO_DATE:_default' \
'--timeline-jsonl=[Optional explicit timeline JSONL input]:TIMELINE_JSONL:_files' \
'--learnings-jsonl=[Optional explicit learnings JSONL input]:LEARNINGS_JSONL:_files' \
'--validation-jsonl=[Optional explicit validation JSONL input]:VALIDATION_JSONL:_files' \
'--review-jsonl=[Optional explicit review JSONL input]:REVIEW_JSONL:_files' \
'--incidents-jsonl=[Optional explicit incidents JSONL input]:INCIDENTS_JSONL:_files' \
'--decisions-jsonl=[Optional explicit decisions JSONL input]:DECISIONS_JSONL:_files' \
'--history-dir=[Explicit local history directory. Does not write unless --write is also set]:HISTORY_DIR:_files -/' \
'--path-class-config=[Optional JSON file overriding path-class assignment\: {"<class>"\: \["<path-prefix>", ...\]}]:PATH_CLASS_CONFIG:_files' \
'--heuristic-root=[Explicit heuristic-system root directory, overriding auto-discovery of heuristic-system / core/policies/heuristic-system]:HEURISTIC_ROOT:_files -/' \
'--write[Write Markdown, raw JSON, and index.jsonl under --history-dir]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':shell:(bash zsh)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_repo-retro__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:repo-retro-help-command-$line[1]:"
        case $line[1] in
            (report)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_repo-retro_commands] )) ||
_repo-retro_commands() {
    local commands; commands=(
'report:' \
'completion:' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'repo-retro commands' commands "$@"
}
(( $+functions[_repo-retro__subcmd__completion_commands] )) ||
_repo-retro__subcmd__completion_commands() {
    local commands; commands=()
    _describe -t commands 'repo-retro completion commands' commands "$@"
}
(( $+functions[_repo-retro__subcmd__help_commands] )) ||
_repo-retro__subcmd__help_commands() {
    local commands; commands=(
'report:' \
'completion:' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'repo-retro help commands' commands "$@"
}
(( $+functions[_repo-retro__subcmd__help__subcmd__completion_commands] )) ||
_repo-retro__subcmd__help__subcmd__completion_commands() {
    local commands; commands=()
    _describe -t commands 'repo-retro help completion commands' commands "$@"
}
(( $+functions[_repo-retro__subcmd__help__subcmd__help_commands] )) ||
_repo-retro__subcmd__help__subcmd__help_commands() {
    local commands; commands=()
    _describe -t commands 'repo-retro help help commands' commands "$@"
}
(( $+functions[_repo-retro__subcmd__help__subcmd__report_commands] )) ||
_repo-retro__subcmd__help__subcmd__report_commands() {
    local commands; commands=()
    _describe -t commands 'repo-retro help report commands' commands "$@"
}
(( $+functions[_repo-retro__subcmd__report_commands] )) ||
_repo-retro__subcmd__report_commands() {
    local commands; commands=()
    _describe -t commands 'repo-retro report commands' commands "$@"
}

if [ "$funcstack[1]" = "_repo-retro" ]; then
    _repo-retro "$@"
else
    compdef _repo-retro repo-retro
fi
