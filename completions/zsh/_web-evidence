#compdef web-evidence

autoload -U is-at-least

_web-evidence() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_web-evidence_commands" \
"*::: :->web-evidence" \
&& ret=0
    case $state in
    (web-evidence)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:web-evidence-command-$line[1]:"
        case $line[1] in
            (capture)
_arguments "${_arguments_options[@]}" : \
'--out=[Artifact run directory to create or reuse]:DIR:_files -/' \
'--label=[Optional scenario or evidence label]:LABEL:_default' \
'--format=[Output format]:FORMAT:(text json)' \
'--method=[HTTP method to use]:METHOD:(get head)' \
'--timeout-seconds=[Total request timeout in seconds]:SECONDS:_default' \
'--max-body-bytes=[Maximum response body bytes to read before truncating the preview source]:BYTES:_default' \
'--body-preview-bytes=[Maximum redacted body preview bytes to persist]:BYTES:_default' \
'-h[Print help]' \
'--help[Print help]' \
':url -- HTTP or HTTPS URL to capture:_default' \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':shell -- Shell to generate completion script for:(bash zsh)' \
&& ret=0
;;
        esac
    ;;
esac
}

(( $+functions[_web-evidence_commands] )) ||
_web-evidence_commands() {
    local commands; commands=(
'capture:Capture redacted HTTP metadata and artifact files for one URL' \
'completion:Print shell completion script' \
    )
    _describe -t commands 'web-evidence commands' commands "$@"
}
(( $+functions[_web-evidence__subcmd__capture_commands] )) ||
_web-evidence__subcmd__capture_commands() {
    local commands; commands=()
    _describe -t commands 'web-evidence capture commands' commands "$@"
}
(( $+functions[_web-evidence__subcmd__completion_commands] )) ||
_web-evidence__subcmd__completion_commands() {
    local commands; commands=()
    _describe -t commands 'web-evidence completion commands' commands "$@"
}

if [ "$funcstack[1]" = "_web-evidence" ]; then
    _web-evidence "$@"
else
    compdef _web-evidence web-evidence
fi
