#compdef agent-memory

_nils_cli_agent_memory_source_common_zsh() {
  (( $+functions[_nils_cli_completion_common_load_dynamic_zsh] )) && return 0

  local source_file="${functions_source[_agent-memory]-}"
  local helper_path=''

  if [[ -n "$source_file" && -r "$source_file" ]]; then
    helper_path="${source_file:h}/_completion-adapter-common.zsh"
    if [[ -r "$helper_path" ]]; then
      source "$helper_path" || return 1
      (( $+functions[_nils_cli_completion_common_load_dynamic_zsh] )) && return 0
    fi
  fi

  local dir=''
  for dir in "${fpath[@]}"; do
    helper_path="${dir}/_completion-adapter-common.zsh"
    if [[ -r "$helper_path" ]]; then
      source "$helper_path" || return 1
      (( $+functions[_nils_cli_completion_common_load_dynamic_zsh] )) && return 0
    fi
  done

  return 1
}

typeset -gi _NILS_AGENT_MEMORY_ZSH_GENERATED_STATE=0

_nils_cli_agent_memory_load_generated_zsh() {
  _nils_cli_agent_memory_source_common_zsh || return 1

  # agent-memory is completion_engine=dynamic: load the clap_complete
  # `CompleteEnv` registration stub emitted by `agent-memory completion zsh` as a
  # generated function (renamed from `_clap_dynamic_completer_agent_memory`).
  _nils_cli_completion_common_load_dynamic_zsh \
    "_NILS_AGENT_MEMORY_ZSH_GENERATED_STATE" \
    "_nils_cli_agent_memory_generated" \
    "agent-memory" \
    "_clap_dynamic_completer_agent_memory"
}

_agent-memory() {
  emulate -L zsh -o extendedglob

  if ! _nils_cli_agent_memory_load_generated_zsh; then
    if (( $+functions[_nils_cli_completion_common_fail_closed_zsh] )); then
      _nils_cli_completion_common_fail_closed_zsh
    fi
    return 1
  fi

  _nils_cli_agent_memory_generated
}

if _nils_cli_agent_memory_source_common_zsh; then
  _nils_cli_completion_common_register_zsh _agent-memory agent-memory
else
  compdef _agent-memory agent-memory
fi
