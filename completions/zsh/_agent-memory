#compdef agent-memory

autoload -U is-at-least

_agent-memory() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_agent-memory_commands" \
"*::: :->agent-memory" \
&& ret=0
    case $state in
    (agent-memory)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:agent-memory-command-$line[1]:"
        case $line[1] in
            (path)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'::scope -- Scope to resolve:_files -/' \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'::scope -- Scope to resolve:_files -/' \
&& ret=0
;;
(index)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'::scope -- Scope to resolve:_files -/' \
&& ret=0
;;
(agents)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(personas)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(init-agent)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':id -- Agent or persona ID:_default' \
&& ret=0
;;
(init-persona)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':id -- Agent or persona ID:_default' \
&& ret=0
;;
(resolve)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':id -- Agent or persona ID:_default' \
&& ret=0
;;
(env)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(doctor)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(check)
_arguments "${_arguments_options[@]}" : \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'--all[Check every memory scope (global, agents, personas)]' \
'--strict[Promote warn-level findings to failures]' \
'(--format)--json[Hidden alias for \`--format json\` (kept for convenience)]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'::scope -- Scope to check (default\: global):_files -/' \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':shell:(bash zsh)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
        esac
    ;;
esac
}

(( $+functions[_agent-memory_commands] )) ||
_agent-memory_commands() {
    local commands; commands=(
'path:Print directory for a scope' \
'list:List markdown files in a scope' \
'index:Print MEMORY.md from a scope' \
'agents:List registered per-agent scopes' \
'personas:List registered Claude Code personas' \
'init-agent:Create a per-agent memory scope' \
'init-persona:Scaffold a Claude Code persona launchpad' \
'resolve:Print global and per-agent paths' \
'env:Emit shell exports for the resolved layout' \
'doctor:Verify memory-store layout' \
'check:Check structural integrity of a memory scope' \
'completion:Print shell completion script' \
'help:Print help' \
    )
    _describe -t commands 'agent-memory commands' commands "$@"
}
