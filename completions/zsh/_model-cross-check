#compdef model-cross-check

autoload -U is-at-least

_model-cross-check() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_model-cross-check_commands" \
"*::: :->model-cross-check" \
&& ret=0
    case $state in
    (model-cross-check)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:model-cross-check-command-$line[1]:"
        case $line[1] in
            (init)
_arguments "${_arguments_options[@]}" : \
'--out=[Artifact directory containing \`model-cross-check.json\`]:DIR:_files -/' \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'--prompt=[Prompt or task being cross-checked]:TEXT:_default' \
'--primary-model=[Primary model label]:TEXT:_default' \
'--checker-model=[Checker model label]:TEXT:_default' \
'*--criterion=[Check criterion. Repeat for multiple criteria]:TEXT:_default' \
'--force[Overwrite an existing record]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(record-observation)
_arguments "${_arguments_options[@]}" : \
'--out=[Artifact directory containing \`model-cross-check.json\`]:DIR:_files -/' \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'--role=[Observation role]:ROLE:(primary checker)' \
'--model=[Model label]:TEXT:_default' \
'--verdict=[Verdict for this observation]:VERDICT:(pass fail inconclusive)' \
'--summary=[Concise observation summary]:TEXT:_default' \
'*--artifact=[Optional evidence artifact path. Repeat for multiple artifacts]:PATH:_files' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(verify)
_arguments "${_arguments_options[@]}" : \
'--out=[Artifact directory containing \`model-cross-check.json\`]:DIR:_files -/' \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(show)
_arguments "${_arguments_options[@]}" : \
'--out=[Artifact directory containing \`model-cross-check.json\`]:DIR:_files -/' \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':shell -- Shell to generate completion script for:(bash zsh)' \
&& ret=0
;;
        esac
    ;;
esac
}

(( $+functions[_model-cross-check_commands] )) ||
_model-cross-check_commands() {
    local commands; commands=(
'init:Create a model cross-check record' \
'record-observation:Append one manually captured model observation' \
'verify:Verify both primary and checker observations are recorded' \
'show:Print the current record' \
'completion:Print shell completion script' \
    )
    _describe -t commands 'model-cross-check commands' commands "$@"
}
(( $+functions[_model-cross-check__subcmd__completion_commands] )) ||
_model-cross-check__subcmd__completion_commands() {
    local commands; commands=()
    _describe -t commands 'model-cross-check completion commands' commands "$@"
}
(( $+functions[_model-cross-check__subcmd__init_commands] )) ||
_model-cross-check__subcmd__init_commands() {
    local commands; commands=()
    _describe -t commands 'model-cross-check init commands' commands "$@"
}
(( $+functions[_model-cross-check__subcmd__record-observation_commands] )) ||
_model-cross-check__subcmd__record-observation_commands() {
    local commands; commands=()
    _describe -t commands 'model-cross-check record-observation commands' commands "$@"
}
(( $+functions[_model-cross-check__subcmd__show_commands] )) ||
_model-cross-check__subcmd__show_commands() {
    local commands; commands=()
    _describe -t commands 'model-cross-check show commands' commands "$@"
}
(( $+functions[_model-cross-check__subcmd__verify_commands] )) ||
_model-cross-check__subcmd__verify_commands() {
    local commands; commands=()
    _describe -t commands 'model-cross-check verify commands' commands "$@"
}

if [ "$funcstack[1]" = "_model-cross-check" ]; then
    _model-cross-check "$@"
else
    compdef _model-cross-check model-cross-check
fi
