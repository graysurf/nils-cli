#compdef agent-docs

autoload -U is-at-least

_agent-docs() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--docs-home=[Override the docs-home root (otherwise derived from the install symlink)]:PATH:_files' \
'--project-path=[Override the project root path]:PATH:_files' \
'--worktree-fallback=[Project worktree fallback mode]:MODE:(auto local-only)' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_agent-docs_commands" \
"*::: :->agent-docs" \
&& ret=0
    case $state in
    (agent-docs)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:agent-docs-command-$line[1]:"
        case $line[1] in
            (audit)
_arguments "${_arguments_options[@]}" : \
'--target=[Audit scope target]:TARGET:(home project all)' \
'--format=[Output format]:FORMAT:(text json)' \
'--docs-home=[Override the docs-home root (otherwise derived from the install symlink)]:PATH:_files' \
'--project-path=[Override the project root path]:PATH:_files' \
'--worktree-fallback=[Project worktree fallback mode]:MODE:(auto local-only)' \
'--strict[Exit non-zero when the audit finds problems]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(preflight)
_arguments "${_arguments_options[@]}" : \
'--intent=[Intent to resolve (for example project-dev)]:INTENT:_default' \
'--format=[Output format]:FORMAT:(text json)' \
'--docs-home=[Override the docs-home root (otherwise derived from the install symlink)]:PATH:_files' \
'--project-path=[Override the project root path]:PATH:_files' \
'--worktree-fallback=[Project worktree fallback mode]:MODE:(auto local-only)' \
'--strict[Exit non-zero when required docs are unsatisfied]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(init)
_arguments "${_arguments_options[@]}" : \
'--format=[Output format for dry-run / write reports]:FORMAT:(text json)' \
'--docs-home=[Override the docs-home root (otherwise derived from the install symlink)]:PATH:_files' \
'--project-path=[Override the project root path]:PATH:_files' \
'--worktree-fallback=[Project worktree fallback mode]:MODE:(auto local-only)' \
'--print[Print the stub to stdout without writing (default)]' \
'--dry-run[Report the target path and stub without writing]' \
'--force[Write the stub, overwriting any existing AGENT_DOCS.toml]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(explain)
_arguments "${_arguments_options[@]}" : \
'--intent=[Intent to explain; omit to list available intents]:INTENT:_default' \
'--format=[Output format]:FORMAT:(text json)' \
'--docs-home=[Override the docs-home root (otherwise derived from the install symlink)]:PATH:_files' \
'--project-path=[Override the project root path]:PATH:_files' \
'--worktree-fallback=[Project worktree fallback mode]:MODE:(auto local-only)' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
'--format=[Output format]:FORMAT:(text json)' \
'--docs-home=[Override the docs-home root (otherwise derived from the install symlink)]:PATH:_files' \
'--project-path=[Override the project root path]:PATH:_files' \
'--worktree-fallback=[Project worktree fallback mode]:MODE:(auto local-only)' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(remove)
_arguments "${_arguments_options[@]}" : \
'--context=[Context/intent of the entry to remove]:INTENT:_default' \
'--scope=[Scope of the entry to remove]:SCOPE:(home project global)' \
'--path=[Document path of the entry to remove]:PATH:_files' \
'--format=[Output format]:FORMAT:(text json)' \
'--docs-home=[Override the docs-home root (otherwise derived from the install symlink)]:PATH:_files' \
'--project-path=[Override the project root path]:PATH:_files' \
'--worktree-fallback=[Project worktree fallback mode]:MODE:(auto local-only)' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
'--docs-home=[Override the docs-home root (otherwise derived from the install symlink)]:PATH:_files' \
'--project-path=[Override the project root path]:PATH:_files' \
'--worktree-fallback=[Project worktree fallback mode]:MODE:(auto local-only)' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':shell:(bash zsh)' \
&& ret=0
;;
        esac
    ;;
esac
}

(( $+functions[_agent-docs_commands] )) ||
_agent-docs_commands() {
    local commands; commands=(
'audit:Audit repo health\: symlink wiring, declared-doc validity, catalog validity' \
'preflight:Resolve the doc set and validation contract for an intent (for hooks)' \
'init:Emit an annotated project-local override stub' \
'explain:Explain what an intent resolves to and why' \
'list:List the declared documents, validation contracts, and intents' \
'remove:Remove a \`\[\[document\]\]\` entry from the project catalog' \
'completion:Generate shell completion scripts' \
    )
    _describe -t commands 'agent-docs commands' commands "$@"
}
(( $+functions[_agent-docs__subcmd__audit_commands] )) ||
_agent-docs__subcmd__audit_commands() {
    local commands; commands=()
    _describe -t commands 'agent-docs audit commands' commands "$@"
}
(( $+functions[_agent-docs__subcmd__completion_commands] )) ||
_agent-docs__subcmd__completion_commands() {
    local commands; commands=()
    _describe -t commands 'agent-docs completion commands' commands "$@"
}
(( $+functions[_agent-docs__subcmd__explain_commands] )) ||
_agent-docs__subcmd__explain_commands() {
    local commands; commands=()
    _describe -t commands 'agent-docs explain commands' commands "$@"
}
(( $+functions[_agent-docs__subcmd__init_commands] )) ||
_agent-docs__subcmd__init_commands() {
    local commands; commands=()
    _describe -t commands 'agent-docs init commands' commands "$@"
}
(( $+functions[_agent-docs__subcmd__list_commands] )) ||
_agent-docs__subcmd__list_commands() {
    local commands; commands=()
    _describe -t commands 'agent-docs list commands' commands "$@"
}
(( $+functions[_agent-docs__subcmd__preflight_commands] )) ||
_agent-docs__subcmd__preflight_commands() {
    local commands; commands=()
    _describe -t commands 'agent-docs preflight commands' commands "$@"
}
(( $+functions[_agent-docs__subcmd__remove_commands] )) ||
_agent-docs__subcmd__remove_commands() {
    local commands; commands=()
    _describe -t commands 'agent-docs remove commands' commands "$@"
}

if [ "$funcstack[1]" = "_agent-docs" ]; then
    _agent-docs "$@"
else
    compdef _agent-docs agent-docs
fi
