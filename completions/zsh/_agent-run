#compdef agent-run

autoload -U is-at-least

_agent-run() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_agent-run_commands" \
"*::: :->agent-run" \
&& ret=0
    case $state in
    (agent-run)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:agent-run-command-$line[1]:"
        case $line[1] in
            (exec)
_arguments "${_arguments_options[@]}" : \
'--cwd=[Working directory for env discovery and child execution]:DIR:_files -/' \
'--direnv=[Direnv policy for project env files]:DIRENV:(auto require off)' \
'-h[Print help]' \
'--help[Print help]' \
'*::command -- Command argv to execute. Pass after `--`:_default' \
&& ret=0
;;
(inspect)
_arguments "${_arguments_options[@]}" : \
'--cwd=[Working directory visible read-only to the inspection command]:DIR:_files -/' \
'-h[Print help]' \
'--help[Print help]' \
'*::command -- Exact command argv to execute in the enforced sandbox. Pass after `--`:_default' \
&& ret=0
;;
(doctor)
_arguments "${_arguments_options[@]}" : \
'--cwd=[Working directory for env discovery]:DIR:_files -/' \
'--direnv=[Direnv policy to evaluate]:DIRENV:(auto require off)' \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(env)
_arguments "${_arguments_options[@]}" : \
'--cwd=[Working directory for env discovery]:DIR:_files -/' \
'--direnv=[Direnv policy to evaluate]:DIRENV:(auto require off)' \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':shell -- Shell to generate completion script for:(bash zsh)' \
&& ret=0
;;
(operation-effect)
_arguments "${_arguments_options[@]}" : \
'--format=[]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'*::argv:_default' \
&& ret=0
;;
        esac
    ;;
esac
}

(( $+functions[_agent-run_commands] )) ||
_agent-run_commands() {
    local commands; commands=(
'exec:Execute a command in the selected project environment' \
'inspect:Execute a local inspection command in a read-only, network-denied OS sandbox' \
'doctor:Report project environment readiness' \
'env:Emit machine-readable project environment status' \
'completion:Print shell completion script' \
'operation-effect:' \
    )
    _describe -t commands 'agent-run commands' commands "$@"
}
(( $+functions[_agent-run__subcmd__completion_commands] )) ||
_agent-run__subcmd__completion_commands() {
    local commands; commands=()
    _describe -t commands 'agent-run completion commands' commands "$@"
}
(( $+functions[_agent-run__subcmd__doctor_commands] )) ||
_agent-run__subcmd__doctor_commands() {
    local commands; commands=()
    _describe -t commands 'agent-run doctor commands' commands "$@"
}
(( $+functions[_agent-run__subcmd__env_commands] )) ||
_agent-run__subcmd__env_commands() {
    local commands; commands=()
    _describe -t commands 'agent-run env commands' commands "$@"
}
(( $+functions[_agent-run__subcmd__exec_commands] )) ||
_agent-run__subcmd__exec_commands() {
    local commands; commands=()
    _describe -t commands 'agent-run exec commands' commands "$@"
}
(( $+functions[_agent-run__subcmd__inspect_commands] )) ||
_agent-run__subcmd__inspect_commands() {
    local commands; commands=()
    _describe -t commands 'agent-run inspect commands' commands "$@"
}
(( $+functions[_agent-run__subcmd__operation-effect_commands] )) ||
_agent-run__subcmd__operation-effect_commands() {
    local commands; commands=()
    _describe -t commands 'agent-run operation-effect commands' commands "$@"
}

if [ "$funcstack[1]" = "_agent-run" ]; then
    _agent-run "$@"
else
    compdef _agent-run agent-run
fi
