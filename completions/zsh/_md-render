#compdef md-render

autoload -U is-at-least

_md-render() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--format=[Output format envelope. \`text\` writes rendered Markdown to stdout; \`json\` wraps the rendered body in the \`cli.md-render.render.v1\` envelope]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'--template=[Path to the \`.md.tera\` template file]:TEMPLATE:_files' \
'--data=[Path to the JSON data file. The contents are passed to \`Engine\:\:render_value\` as the template'\''s view]:DATA:_files' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_md-render_commands" \
"*::: :->md-render" \
&& ret=0
    case $state in
    (md-render)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:md-render-command-$line[1]:"
        case $line[1] in
            (render)
_arguments "${_arguments_options[@]}" : \
'--template=[Path to the \`.md.tera\` template file]:TEMPLATE:_files' \
'--data=[Path to the JSON data file. The contents are passed to \`Engine\:\:render_value\` as the template'\''s view]:DATA:_files' \
'--format=[Output format envelope. \`text\` writes rendered Markdown to stdout; \`json\` wraps the rendered body in the \`cli.md-render.render.v1\` envelope]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
'--format=[Output format envelope. \`text\` writes rendered Markdown to stdout; \`json\` wraps the rendered body in the \`cli.md-render.render.v1\` envelope]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':shell -- Shell to emit completion for:(bash zsh)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_md-render__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:md-render-help-command-$line[1]:"
        case $line[1] in
            (render)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_md-render_commands] )) ||
_md-render_commands() {
    local commands; commands=(
'render:Render a template against a JSON data file (explicit form)' \
'completion:Emit shell completion script (bash or zsh) to stdout' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'md-render commands' commands "$@"
}
(( $+functions[_md-render__subcmd__completion_commands] )) ||
_md-render__subcmd__completion_commands() {
    local commands; commands=()
    _describe -t commands 'md-render completion commands' commands "$@"
}
(( $+functions[_md-render__subcmd__help_commands] )) ||
_md-render__subcmd__help_commands() {
    local commands; commands=(
'render:Render a template against a JSON data file (explicit form)' \
'completion:Emit shell completion script (bash or zsh) to stdout' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'md-render help commands' commands "$@"
}
(( $+functions[_md-render__subcmd__help__subcmd__completion_commands] )) ||
_md-render__subcmd__help__subcmd__completion_commands() {
    local commands; commands=()
    _describe -t commands 'md-render help completion commands' commands "$@"
}
(( $+functions[_md-render__subcmd__help__subcmd__help_commands] )) ||
_md-render__subcmd__help__subcmd__help_commands() {
    local commands; commands=()
    _describe -t commands 'md-render help help commands' commands "$@"
}
(( $+functions[_md-render__subcmd__help__subcmd__render_commands] )) ||
_md-render__subcmd__help__subcmd__render_commands() {
    local commands; commands=()
    _describe -t commands 'md-render help render commands' commands "$@"
}
(( $+functions[_md-render__subcmd__render_commands] )) ||
_md-render__subcmd__render_commands() {
    local commands; commands=()
    _describe -t commands 'md-render render commands' commands "$@"
}

if [ "$funcstack[1]" = "_md-render" ]; then
    _md-render "$@"
else
    compdef _md-render md-render
fi
