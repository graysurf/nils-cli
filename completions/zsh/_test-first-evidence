#compdef test-first-evidence

autoload -U is-at-least

_test-first-evidence() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_test-first-evidence_commands" \
"*::: :->test-first-evidence" \
&& ret=0
    case $state in
    (test-first-evidence)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:test-first-evidence-command-$line[1]:"
        case $line[1] in
            (init)
_arguments "${_arguments_options[@]}" : \
'--out=[Evidence artifact directory containing \`test-first-evidence.json\`]:DIR:_files -/' \
'--format=[Output format]:FORMAT:(text json)' \
'--classification=[Change classification. Feature/bug delivery requires a testable classification]:CLASSIFICATION:(behavior-change bug-fix feature docs-only config-only generated-only refactor-only)' \
'*--production-path=[Production path affected by the change. Repeat for multiple paths]:PATH:_files' \
'*--note=[Optional note to keep with the record. Repeat for multiple notes]:TEXT:_default' \
'*--retained-behavior=[Existing behavior or invariant that must remain unchanged. Repeatable]:TEXT:_default' \
'*--changed-behavior=[Existing behavior intentionally changed by this work. Repeatable]:TEXT:_default' \
'*--removed-behavior=[Existing behavior intentionally removed by this work. Repeatable]:TEXT:_default' \
'*--added-behavior=[New behavior added by this work. Repeatable]:TEXT:_default' \
'*--invariant=[Cross-change invariant that must continue to hold. Repeatable]:TEXT:_default' \
'--force[Overwrite an existing record]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(record-failing)
_arguments "${_arguments_options[@]}" : \
'--out=[Evidence artifact directory containing \`test-first-evidence.json\`]:DIR:_files -/' \
'--format=[Output format]:FORMAT:(text json)' \
'--command=[Command or manual step that produced the before-fix failure]:TEXT:_default' \
'--exit-code=[Exit code from the failing command]:CODE:_default' \
'--summary=[Concise failure summary]:TEXT:_default' \
'--expected-failure=[Failure that should occur because the intended behavior is not implemented yet]:TEXT:_default' \
'--observed-failure=[Failure actually observed in the before-fix run]:TEXT:_default' \
'--test-name=[Optional test name or scenario identifier]:TEXT:_default' \
'*--artifact=[Optional evidence artifact path. Repeat for multiple artifacts]:PATH:_files' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(record-impact)
_arguments "${_arguments_options[@]}" : \
'--out=[Evidence artifact directory containing \`test-first-evidence.json\`]:DIR:_files -/' \
'--format=[Output format]:FORMAT:(text json)' \
'--target=[Test name, path, suite, fixture family, or snapshot group]:TEXT:_default' \
'--disposition=[Planned disposition for the affected target]:DISPOSITION:(keep update-spec remove-superseded add-missing refactor-only)' \
'--protected-behavior=[Behavior or risk protected by the target]:TEXT:_default' \
'--reason=[Why this disposition is correct. Required for both target and none forms]:TEXT:_default' \
'--owner-test=[Replacement or primary owner test when another target preserves the contract]:TEXT:_default' \
'*--validation-scope=[Final validation scopes required by this impact. Repeatable]:VALIDATION_SCOPES:(focused affected-suite contract-consumer full manual)' \
'--none[Declare that no existing test target is materially affected]' \
'--invariant-retired[Confirm that a removed test'\''s protected invariant is intentionally retired]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(record-waiver)
_arguments "${_arguments_options[@]}" : \
'--out=[Evidence artifact directory containing \`test-first-evidence.json\`]:DIR:_files -/' \
'--format=[Output format]:FORMAT:(text json)' \
'--reason=[Reason failing-test evidence was not practical]:TEXT:_default' \
'--waiver-kind=[Whether the change is permanently non-testable or carries deferred test debt]:WAIVER_KIND:(non-testable deferred-debt)' \
'--why-no-red=[Why meaningful failing evidence cannot be captured now]:TEXT:_default' \
'*--substitute-validation=[Substitute validation captured before editing. Repeat for multiple items]:TEXT:_default' \
'--follow-up=[Durable follow-up issue or action for deferred test debt]:TEXT:_default' \
'--expires=[Expiry or removal condition for deferred test debt]:TEXT:_default' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(record-final)
_arguments "${_arguments_options[@]}" : \
'--out=[Evidence artifact directory containing \`test-first-evidence.json\`]:DIR:_files -/' \
'--format=[Output format]:FORMAT:(text json)' \
'--command=[Final validation command or manual validation step]:TEXT:_default' \
'--status=[Final validation status]:STATUS:(pass fail)' \
'--scope=[Risk scope proven by this validation]:SCOPE:(focused affected-suite contract-consumer full manual)' \
'--summary=[Optional final validation summary]:TEXT:_default' \
'*--artifact=[Optional validation artifact path. Repeat for multiple artifacts]:PATH:_files' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(record-gap)
_arguments "${_arguments_options[@]}" : \
'--out=[Evidence artifact directory containing \`test-first-evidence.json\`]:DIR:_files -/' \
'--format=[Output format]:FORMAT:(text json)' \
'--gap=[Residual gap accepted for this delivery]:TEXT:_default' \
'--reason=[Why the residual gap is acceptable now]:TEXT:_default' \
'--follow-up=[Durable follow-up issue or action for the gap]:TEXT:_default' \
'--none[Explicitly declare that no residual validation or coverage gaps remain]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(bind-baseline)
_arguments "${_arguments_options[@]}" : \
'--out=[Evidence artifact directory containing \`test-first-evidence.json\`]:DIR:_files -/' \
'--format=[Output format]:FORMAT:(text json)' \
'--project-path=[Git repository whose baseline or delivery subject is being bound]:DIR:_files -/' \
'--remote=[Git remote used for provider repository identity when available]:NAME:_default' \
'--repository-id=[Stable repository identity override for provider/local targets without a usable remote]:ID:_default' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(bind-delivery)
_arguments "${_arguments_options[@]}" : \
'--out=[Evidence artifact directory containing \`test-first-evidence.json\`]:DIR:_files -/' \
'--format=[Output format]:FORMAT:(text json)' \
'--project-path=[Git repository whose baseline or delivery subject is being bound]:DIR:_files -/' \
'--remote=[Git remote used for provider repository identity when available]:NAME:_default' \
'--repository-id=[Stable repository identity override for provider/local targets without a usable remote]:ID:_default' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(check)
_arguments "${_arguments_options[@]}" : \
'--out=[Evidence artifact directory containing \`test-first-evidence.json\`]:DIR:_files -/' \
'--format=[Output format]:FORMAT:(text json)' \
'--phase=[Readiness phase to evaluate]:PHASE:(classified pre-edit delivery)' \
'--project-path=[Repository root used by the pre-edit path-class contract]:DIR:_files -/' \
'*--path=[Repository-relative path to classify. Repeat for batches]:PATH:_files' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(verify)
_arguments "${_arguments_options[@]}" : \
'--out=[Evidence artifact directory containing \`test-first-evidence.json\`]:DIR:_files -/' \
'--format=[Output format]:FORMAT:(text json)' \
'--project-path=[Also require the latest delivery subject to match this Git repository]:DIR:_files -/' \
'--remote=[Git remote used for provider repository identity when available]:NAME:_default' \
'--repository-id=[Stable repository identity override used when checking the subject]:ID:_default' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(show)
_arguments "${_arguments_options[@]}" : \
'--out=[Evidence artifact directory containing \`test-first-evidence.json\`]:DIR:_files -/' \
'--format=[Output format]:FORMAT:(text json)' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':shell -- Shell to generate completion script for:(bash zsh)' \
&& ret=0
;;
        esac
    ;;
esac
}

(( $+functions[_test-first-evidence_commands] )) ||
_test-first-evidence_commands() {
    local commands; commands=(
'init:Create a deterministic evidence record' \
'record-failing:Record a failing test or reproducible failure before the fix' \
'record-impact:Record one materially affected test target or declare none exist' \
'record-waiver:Record an explicit waiver when failing evidence is not practical' \
'record-final:Record final validation after the implementation' \
'record-gap:Record one residual gap or explicitly declare that none remain' \
'bind-baseline:Bind the immutable repository and pre-edit baseline subject' \
'bind-delivery:Append an attestation for the current delivered head and diff' \
'check:Query classified, pre-edit, or delivery readiness without mutating the record' \
'verify:Verify the evidence record is complete enough for delivery' \
'show:Print the current evidence record' \
'completion:Print shell completion script' \
    )
    _describe -t commands 'test-first-evidence commands' commands "$@"
}
