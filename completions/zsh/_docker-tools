            (down)
_arguments "${_arguments_options[@]}" : \
'-a[Add --remove-orphans --volumes --rmi all]' \
'--all[Add --remove-orphans --volumes --rmi all]' \
'-y[Skip confirmation prompts for --all]' \
'--yes[Skip confirmation prompts for --all]' \
'-h[Print help]' \
'--help[Print help]' \
'*::args -- Extra arguments passed after docker compose down:_default' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_docker-tools__subcmd__compose__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

