#compdef docker-tools

autoload -U is-at-least

_docker-tools() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_docker-tools_commands" \
"*::: :->docker-tools" \
&& ret=0
    case $state in
    (docker-tools)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:docker-tools-command-$line[1]:"
        case $line[1] in
            (container)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
":: :_docker-tools__subcmd__container_commands" \
"*::: :->container" \
&& ret=0

    case $state in
    (container)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:docker-tools-container-command-$line[1]:"
        case $line[1] in
            (sh)
_arguments "${_arguments_options[@]}" : \
'(-r --root)-u+[User inside the container]:user:_default' \
'(-r --root)--user=[User inside the container]:user:_default' \
'-r[Exec as root]' \
'--root[Exec as root]' \
'-h[Print help]' \
'--help[Print help]' \
':container -- Container name or id:_default' \
&& ret=0
;;
(zsh)
_arguments "${_arguments_options[@]}" : \
'(-r --root)-u+[User inside the container]:user:_default' \
'(-r --root)--user=[User inside the container]:user:_default' \
'-r[Exec as root]' \
'--root[Exec as root]' \
'-h[Print help]' \
'--help[Print help]' \
':container -- Container name or id:_default' \
&& ret=0
;;
(rm)
_arguments "${_arguments_options[@]}" : \
'--no-force[Do not force remove containers]' \
'-v[Remove anonymous volumes]' \
'--volumes[Remove anonymous volumes]' \
'-h[Print help]' \
'--help[Print help]' \
'*::containers -- Container names or ids:_default' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_docker-tools__subcmd__container__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:docker-tools-container-help-command-$line[1]:"
        case $line[1] in
            (sh)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(zsh)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(rm)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
;;
(compose)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
":: :_docker-tools__subcmd__compose_commands" \
"*::: :->compose" \
&& ret=0

    case $state in
    (compose)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:docker-tools-compose-command-$line[1]:"
