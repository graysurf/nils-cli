_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
(compose)
_arguments "${_arguments_options[@]}" : \
":: :_docker-tools__subcmd__help__subcmd__compose_commands" \
"*::: :->compose" \
&& ret=0

    case $state in
    (compose)
        words=($line[1] "${words[@]}")
