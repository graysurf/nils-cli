#compdef gxwcd
# Worktree-name completion for the `gxwcd` helper (a shell function that wraps
# `git-cli worktree go --shell` to cd on select).
#
# Autoloaded via compinit from `fpath`, so it registers regardless of whether
# the nils-cli alias bundle is sourced before or after `compinit` runs, and it
# feeds candidates straight from the live `git worktree list`.
#
# Note: `git-cli worktree go`/`remove` now complete worktree names/branches
# directly via clap_complete `CompleteEnv` (completion_engine=dynamic), so this
# file no longer works around a static-completion gap. It is retained only
# because `gxwcd` is a *shell function* (not the `git-cli` binary), so the
# binary's dynamic completion cannot register for it; the candidate source is
# identical. Agents never reach this completion path.

local -a _nils_wt
_nils_wt=( ${(f)"$(command git worktree list --porcelain 2>/dev/null | awk '
  /^worktree /  { n = split($2, p, "/"); print p[n] }
  /^branch /    { b = $2; sub(/^refs\/heads\//, "", b); print b }
')"} )
compadd -- $_nils_wt
