(( $+functions[_evidence_commands] )) ||
_evidence_commands() {
    local commands; commands=(
'validate-hosts:Validate an archive \`config/hosts.yaml\` document' \
'validate-local:Validate a machine-local \`agent-evidence-archive/config.yaml\` document. Missing files return documented defaults with exit code 0' \
'validate-record:Validate an archived \`skill-usage.rollup.json\` document' \
'migrate:Migrate skill-usage records out of the agent-out tree into the archive. Dry-run by default; use \`--apply\` to write, commit, and push' \
'purge:Purge archived evidence for named hosts / host classes (the retention counterpart to \`migrate\`; e.g. employer \`delete-on-termination\`). Dry-run by default; \`--apply\` deletes, regenerates the catalog, commits, and pushes. A scope (\`--host\` and/or \`--class\`) is required — there is no implicit whole-archive purge' \
'prune-source:Prune local agent-out source run directories whose raw records are already archived. Dry-run by default; \`--apply\` deletes only run directories whose \`skill-usage.record.json\` digest exists in the archive catalog' \
'discover:Read-only scan of the agent-out tree for archivable records' \
'catalog:Generate, write, or filter the derived archive catalog' \
'query:Filtered read over archived rollups (cross-version aware)' \
'search:Substring search over catalog rows'\'' intent + outcome summary' \
'completion:Print a shell completion script for \`evidence\`' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'evidence commands' commands "$@"
}
