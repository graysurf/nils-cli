autoload -U is-at-least

_evidence() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--format=[Output format (defaults to text)]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'(--format)--json[Hidden alias for \`--format json\` kept for symmetry with neighbouring CLIs]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_evidence_commands" \
"*::: :->evidence" \
&& ret=0
    case $state in
    (evidence)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:evidence-command-$line[1]:"
        case $line[1] in
            (validate-hosts)
_arguments "${_arguments_options[@]}" : \
'--input=[Path to the YAML file to validate. Use \`-\` for stdin]:INPUT:_default' \
'--format=[Output format (defaults to text)]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'(--format)--json[Hidden alias for \`--format json\` kept for symmetry with neighbouring CLIs]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(validate-local)
_arguments "${_arguments_options[@]}" : \
'--input=[Path to the local config file. Missing files are allowed]:INPUT:_default' \
'--format=[Output format (defaults to text)]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'(--format)--json[Hidden alias for \`--format json\` kept for symmetry with neighbouring CLIs]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(validate-record)
_arguments "${_arguments_options[@]}" : \
'--input=[Path to the rollup JSON file to validate. Use \`-\` for stdin]:INPUT:_default' \
'--format=[Output format (defaults to text)]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'(--format)--json[Hidden alias for \`--format json\` kept for symmetry with neighbouring CLIs]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(migrate)
_arguments "${_arguments_options[@]}" : \
'--source-out=[Agent-out projects root. Defaults to \`\${AGENT_HOME}/out/projects\`]:SOURCE_OUT:_files' \
'--archive=[Archive clone path. Defaults to \`\$AGENT_EVIDENCE_ARCHIVE_HOME\`, the local config, or the XDG data-home default]:ARCHIVE:_files' \
'--hosts=[Path to the archive \`config/hosts.yaml\`. Defaults to \`<archive>/config/hosts.yaml\`]:HOSTS:_files' \
'--repo=[Only migrate records for this repo (\`<owner__repo>\` slug or repo name)]:REPO:_default' \
'--skill=[Only migrate records whose skill path/id contains this substring]:SKILL:_default' \
'--since=[Only records started on or after this \`YYYY-MM-DD\`]:SINCE:_default' \
'--until=[Only records started on or before this \`YYYY-MM-DD\`]:UNTIL:_default' \
'--host=[Host (FQDN) to attribute slug-only records to (e.g. \`github.com\`, \`gitlab.example.com\`). The agent-out \`<owner__repo>\` slug carries no host; under a multi-host \`config/hosts.yaml\` this override pins the host the operator vouches for. Must be present in \`config/hosts.yaml\`; records whose dir is not an \`<owner__repo>\` slug, or whose host is absent from the config, are reported as blocked]:HOST:_default' \
'--format=[Output format (defaults to text)]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'--promotion-only[Only records that link a heuristic-inbox promotion case]' \
'--apply[Apply the migration. Without this flag the command runs in dry-run mode]' \
'(--format)--json[Hidden alias for \`--format json\` kept for symmetry with neighbouring CLIs]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(purge)
_arguments "${_arguments_options[@]}" : \
'*--host=[Host (FQDN) to purge (repeatable). Removes \`evidence/<host>/\`]:HOST:_default' \
