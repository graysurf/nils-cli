'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(catalog)
_arguments "${_arguments_options[@]}" : \
'--grep=[Filter records by case-insensitive substring]:GREP:_default' \
'--outcome=[Filter records by exact outcome status (case-insensitive)]:OUTCOME:_default' \
'--case-id=[Filter records by promotion case id substring]:CASE_ID:_default' \
