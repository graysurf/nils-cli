#compdef claude-cli

autoload -U is-at-least

_claude-cli() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_claude-cli_commands" \
"*::: :->claude-cli" \
&& ret=0
    case $state in
    (claude-cli)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:claude-cli-command-$line[1]:"
        case $line[1] in
            (prompt-segment)
_arguments "${_arguments_options[@]}" : \
'--ttl=[Cache TTL]:TTL:_default' \
'--time-format=[Reset time format (local time)]:TIME_FORMAT:_default' \
'--refresh[Force a fetch attempt regardless of TTL]' \
'--is-enabled[Exit 0 if Keychain or credential override has a Claude OAuth access token]' \
'-h[Print help]' \
'--help[Print help]' \
":: :_claude-cli__subcmd__prompt-segment_commands" \
"*::: :->prompt-segment" \
&& ret=0

    case $state in
    (prompt-segment)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:claude-cli-prompt-segment-command-$line[1]:"
        case $line[1] in
            (check)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
'--format=[Output format (\`text\` or \`json\`)]:format:(text json)' \
'(--format)--json[Hidden alias for \`--format json\`]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_claude-cli__subcmd__prompt-segment__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:claude-cli-prompt-segment-help-command-$line[1]:"
        case $line[1] in
            (check)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
;;
(completion)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':shell -- Shell to generate completion script for:(bash zsh)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_claude-cli__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:claude-cli-help-command-$line[1]:"
        case $line[1] in
            (prompt-segment)
_arguments "${_arguments_options[@]}" : \
":: :_claude-cli__subcmd__help__subcmd__prompt-segment_commands" \
"*::: :->prompt-segment" \
&& ret=0

    case $state in
    (prompt-segment)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:claude-cli-help-prompt-segment-command-$line[1]:"
        case $line[1] in
            (check)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
(completion)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_claude-cli_commands] )) ||
_claude-cli_commands() {
    local commands; commands=(
'prompt-segment:Prompt-segment command group' \
'completion:Export shell completion script' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'claude-cli commands' commands "$@"
}
(( $+functions[_claude-cli__subcmd__completion_commands] )) ||
_claude-cli__subcmd__completion_commands() {
