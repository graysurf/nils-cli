_plan-tooling__subcmd__spec_commands() {
    local commands; commands=()
    _describe -t commands 'plan-tooling spec commands' commands "$@"
}
(( $+functions[_plan-tooling__subcmd__split-prs_commands] )) ||
_plan-tooling__subcmd__split-prs_commands() {
    local commands; commands=()
    _describe -t commands 'plan-tooling split-prs commands' commands "$@"
}
(( $+functions[_plan-tooling__subcmd__to-json_commands] )) ||
_plan-tooling__subcmd__to-json_commands() {
    local commands; commands=()
    _describe -t commands 'plan-tooling to-json commands' commands "$@"
}
(( $+functions[_plan-tooling__subcmd__validate_commands] )) ||
_plan-tooling__subcmd__validate_commands() {
    local commands; commands=()
    _describe -t commands 'plan-tooling validate commands' commands "$@"
}

if [ "$funcstack[1]" = "_plan-tooling" ]; then
    _plan-tooling "$@"
else
    compdef _plan-tooling plan-tooling
fi
