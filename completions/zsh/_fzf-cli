#compdef fzf-cli

autoload -U is-at-least

_fzf-cli() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_fzf-cli_commands" \
"*::: :->fzf-cli" \
&& ret=0
    case $state in
    (fzf-cli)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:fzf-cli-command-$line[1]:"
        case $line[1] in
            (file)
_arguments "${_arguments_options[@]}" : \
'--vi[Open selection with vi]' \
'--vscode[Open selection with VS Code]' \
'-h[Print help]' \
'--help[Print help]' \
'*::query:_default' \
&& ret=0
;;
(directory)
_arguments "${_arguments_options[@]}" : \
'--vi[Open selection with vi]' \
'--vscode[Open selection with VS Code]' \
'-h[Print help]' \
'--help[Print help]' \
'*::query:_default' \
&& ret=0
;;
(git-status)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'*::query:_default' \
&& ret=0
;;
(git-commit)
_arguments "${_arguments_options[@]}" : \
'--snapshot[Preview file snapshots from selected commit]' \
'-h[Print help]' \
'--help[Print help]' \
'*::query:_default' \
&& ret=0
;;
(git-checkout)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'*::query:_default' \
&& ret=0
;;
(git-branch)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'*::query:_default' \
&& ret=0
;;
(git-tag)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'*::query:_default' \
&& ret=0
;;
(process)
_arguments "${_arguments_options[@]}" : \
'-k[Kill selected process]' \
'--kill[Kill selected process]' \
'-9[Use SIGKILL when killing]' \
'--force[Use SIGKILL when killing]' \
'-h[Print help]' \
'--help[Print help]' \
'*::query:_default' \
&& ret=0
;;
(port)
_arguments "${_arguments_options[@]}" : \
'-k[Kill owner process for selected port]' \
'--kill[Kill owner process for selected port]' \
'-9[Use SIGKILL when killing]' \
'--force[Use SIGKILL when killing]' \
'-h[Print help]' \
'--help[Print help]' \
'*::query:_default' \
&& ret=0
;;
(history)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'*::query:_default' \
&& ret=0
;;
(env)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'*::query:_default' \
&& ret=0
;;
(alias)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'*::query:_default' \
&& ret=0
;;
(function)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'*::query:_default' \
&& ret=0
;;
(def)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'*::query:_default' \
&& ret=0
;;
(open-changed-files)
_arguments "${_arguments_options[@]}" : \
'--workspace-mode=[Workspace grouping mode]:mode:(pwd git)' \
'--max-files=[Max files to open]:N:_default' \
'--list[Open explicit file paths]' \
'--git[Open staged, unstaged, and untracked files]' \
'--dry-run[Print planned code invocations]' \
'-v[Explain no-op behavior and ignored paths]' \
'--verbose[Explain no-op behavior and ignored paths]' \
'-h[Print help]' \
'--help[Print help]' \
'*::files:_default' \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':shell:(bash zsh)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
        esac
    ;;
esac
}

(( $+functions[_fzf-cli_commands] )) ||
_fzf-cli_commands() {
    local commands; commands=(
'file:Search and preview text files' \
'directory:Search directories and cd into selection' \
'git-status:Interactive git status viewer' \
'git-commit:Browse commits and open changed files in editor' \
'git-checkout:Pick and checkout a previous commit' \
'git-branch:Browse and checkout branches interactively' \
'git-tag:Browse and checkout tags interactively' \
'process:Browse and kill running processes' \
'port:Browse listening ports and owners' \
'history:Search and execute command history' \
'env:Browse environment variables' \
'alias:Browse shell aliases' \
'function:Browse defined shell functions' \
'def:Browse all definitions (env, alias, functions)' \
'open-changed-files:Open changed files in VS Code' \
'completion:Export shell completion script' \
'help:Display help message for fzf-cli' \
    )
    _describe -t commands 'fzf-cli commands' commands "$@"
}
