#compdef memo

autoload -U is-at-least

_memo() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--db=[SQLite file path]:path:_files' \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'(--format)--json[Hidden alias for \`--format json\` (kept for backwards compatibility)]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_memo_commands" \
"*::: :->memo" \
&& ret=0
    case $state in
    (memo)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:memo-command-$line[1]:"
        case $line[1] in
            (add)
_arguments "${_arguments_options[@]}" : \
'--source=[Capture source label]:SOURCE:_default' \
'--at=[Capture timestamp (RFC3339)]:AT:_default' \
'--db=[SQLite file path]:path:_files' \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'(--format)--json[Hidden alias for \`--format json\` (kept for backwards compatibility)]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':text -- Memo text:_default' \
&& ret=0
;;
(update)
_arguments "${_arguments_options[@]}" : \
'--db=[SQLite file path]:path:_files' \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'(--format)--json[Hidden alias for \`--format json\` (kept for backwards compatibility)]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':item_id -- Item identifier (itm_XXXXXXXX or integer id):_default' \
':text -- Updated memo text:_default' \
&& ret=0
;;
(delete)
_arguments "${_arguments_options[@]}" : \
'--db=[SQLite file path]:path:_files' \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'--hard[Deprecated compatibility confirmation flag; use --yes to confirm deletion]' \
'-y[Confirm deletion without prompting]' \
'--yes[Confirm deletion without prompting]' \
'(--format)--json[Hidden alias for \`--format json\` (kept for backwards compatibility)]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':item_id -- Item identifier (itm_XXXXXXXX or integer id):_default' \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
'--limit=[Max rows to return]:LIMIT:_default' \
'--offset=[Row offset for paging]:OFFSET:_default' \
'--state=[Row selection mode]:STATE:(all pending enriched)' \
'--db=[SQLite file path]:path:_files' \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'(--format)--json[Hidden alias for \`--format json\` (kept for backwards compatibility)]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(search)
_arguments "${_arguments_options[@]}" : \
'--limit=[Max rows to return]:LIMIT:_default' \
'--state=[Row selection mode]:STATE:(all pending enriched)' \
'*--field=[Search fields (comma-separated)\: raw, derived, tags]:FIELDS:(raw derived tags)' \
'--match=[Search match mode\: fts, prefix, contains]:MATCH_MODE:(fts prefix contains)' \
'--db=[SQLite file path]:path:_files' \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'(--format)--json[Hidden alias for \`--format json\` (kept for backwards compatibility)]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':query -- Search query text:_default' \
&& ret=0
;;
(report)
_arguments "${_arguments_options[@]}" : \
'--tz=[IANA timezone for canonical period windows]:TZ:_default' \
'--from=[Custom report start timestamp (RFC3339)]:FROM:_default' \
'--to=[Custom report end timestamp (RFC3339)]:TO:_default' \
'--db=[SQLite file path]:path:_files' \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'(--format)--json[Hidden alias for \`--format json\` (kept for backwards compatibility)]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':period -- Report period\: week or month:(week month)' \
&& ret=0
;;
(fetch)
_arguments "${_arguments_options[@]}" : \
'--limit=[Max rows to return]:LIMIT:_default' \
'--cursor=[Optional cursor (reserved for future pagination)]:CURSOR:_default' \
'--state=[Fetch selection mode]:STATE:(pending)' \
'--db=[SQLite file path]:path:_files' \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'(--format)--json[Hidden alias for \`--format json\` (kept for backwards compatibility)]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(apply)
_arguments "${_arguments_options[@]}" : \
'--input=[JSON file containing apply payload]:INPUT:_files' \
'--db=[SQLite file path]:path:_files' \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'--stdin[Read payload JSON from stdin]' \
'--dry-run[Validate payload without write-back]' \
'(--format)--json[Hidden alias for \`--format json\` (kept for backwards compatibility)]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
'--db=[SQLite file path]:path:_files' \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'(--format)--json[Hidden alias for \`--format json\` (kept for backwards compatibility)]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':shell:(bash zsh)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_memo__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:memo-help-command-$line[1]:"
        case $line[1] in
            (add)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(update)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(delete)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(search)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(report)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(fetch)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(apply)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_memo_commands] )) ||
_memo_commands() {
    local commands; commands=(
'add:Capture one raw memo entry' \
'update:Update one memo entry and reset derived workflow state' \
'delete:Delete one memo entry and all dependent data' \
'list:List memo entries in deterministic order' \
'search:Search memo entries with selectable match mode' \
'report:Show weekly or monthly summary report' \
'fetch:Fetch pending items for agent enrichment' \
'apply:Apply enrichment payloads' \
'completion:Print shell completion script' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'memo commands' commands "$@"
}
