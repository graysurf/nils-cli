#compdef review-evidence

autoload -U is-at-least

_review-evidence() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_review-evidence_commands" \
"*::: :->review-evidence" \
&& ret=0
    case $state in
    (review-evidence)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:review-evidence-command-$line[1]:"
        case $line[1] in
            (init)
_arguments "${_arguments_options[@]}" : \
'--out=[Artifact directory containing \`review-evidence.json\`]:DIR:_files -/' \
'--format=[Output format]:FORMAT:(text json)' \
'--subject=[Review subject, such as a PR, MR, issue, or patch label]:TEXT:_default' \
'--reviewer=[Optional reviewer or agent label]:TEXT:_default' \
'--force[Overwrite an existing record]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(record-finding)
_arguments "${_arguments_options[@]}" : \
'--out=[Artifact directory containing \`review-evidence.json\`]:DIR:_files -/' \
'--format=[Output format]:FORMAT:(text json)' \
'--severity=[Finding severity]:SEVERITY:(high medium low)' \
'--path=[Finding file path]:PATH:_files' \
'--line=[Optional line number]:LINE:_default' \
'--summary=[Concise finding summary]:TEXT:_default' \
'--status=[Finding resolution status]:STATUS:(open fixed accepted-risk)' \
'*--artifact=[Optional evidence artifact path. Repeat for multiple artifacts]:PATH:_files' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(record-validation)
_arguments "${_arguments_options[@]}" : \
'--out=[Artifact directory containing \`review-evidence.json\`]:DIR:_files -/' \
'--format=[Output format]:FORMAT:(text json)' \
'--command=[Validation command or manual validation step]:TEXT:_default' \
'--status=[Validation status]:STATUS:(pass fail)' \
'--summary=[Optional validation summary]:TEXT:_default' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(verify)
_arguments "${_arguments_options[@]}" : \
'--out=[Artifact directory containing \`review-evidence.json\`]:DIR:_files -/' \
'--format=[Output format]:FORMAT:(text json)' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(show)
_arguments "${_arguments_options[@]}" : \
'--out=[Artifact directory containing \`review-evidence.json\`]:DIR:_files -/' \
'--format=[Output format]:FORMAT:(text json)' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':shell -- Shell to generate completion script for:(bash zsh)' \
&& ret=0
;;
        esac
    ;;
esac
}

(( $+functions[_review-evidence_commands] )) ||
_review-evidence_commands() {
    local commands; commands=(
'init:Create a review evidence record' \
'record-finding:Append one review finding' \
'record-validation:Record final review validation' \
'verify:Verify the review record is complete enough for delivery' \
'show:Print the review record' \
'completion:Print shell completion script' \
    )
    _describe -t commands 'review-evidence commands' commands "$@"
}
(( $+functions[_review-evidence__subcmd__completion_commands] )) ||
_review-evidence__subcmd__completion_commands() {
    local commands; commands=()
    _describe -t commands 'review-evidence completion commands' commands "$@"
}
(( $+functions[_review-evidence__subcmd__init_commands] )) ||
_review-evidence__subcmd__init_commands() {
    local commands; commands=()
    _describe -t commands 'review-evidence init commands' commands "$@"
}
(( $+functions[_review-evidence__subcmd__record-finding_commands] )) ||
_review-evidence__subcmd__record-finding_commands() {
    local commands; commands=()
    _describe -t commands 'review-evidence record-finding commands' commands "$@"
}
(( $+functions[_review-evidence__subcmd__record-validation_commands] )) ||
_review-evidence__subcmd__record-validation_commands() {
    local commands; commands=()
    _describe -t commands 'review-evidence record-validation commands' commands "$@"
}
(( $+functions[_review-evidence__subcmd__show_commands] )) ||
_review-evidence__subcmd__show_commands() {
    local commands; commands=()
    _describe -t commands 'review-evidence show commands' commands "$@"
}
(( $+functions[_review-evidence__subcmd__verify_commands] )) ||
_review-evidence__subcmd__verify_commands() {
    local commands; commands=()
    _describe -t commands 'review-evidence verify commands' commands "$@"
}

if [ "$funcstack[1]" = "_review-evidence" ]; then
    _review-evidence "$@"
else
    compdef _review-evidence review-evidence
fi
