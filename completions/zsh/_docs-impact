#compdef docs-impact

autoload -U is-at-least

_docs-impact() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_docs-impact_commands" \
"*::: :->docs-impact" \
&& ret=0
    case $state in
    (docs-impact)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:docs-impact-command-$line[1]:"
        case $line[1] in
            (scan)
_arguments "${_arguments_options[@]}" : \
'--repo=[Git worktree to scan]:DIR:_files -/' \
'--base=[Base ref for committed branch comparison (\`<base>...HEAD\`)]:REF:_default' \
'--format=[Output format]:FORMAT:(text json)' \
'--include-untracked[Include untracked files from \`git ls-files --others --exclude-standard\`]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':shell -- Shell to generate completion script for:(bash zsh)' \
&& ret=0
;;
        esac
    ;;
esac
}

(( $+functions[_docs-impact_commands] )) ||
_docs-impact_commands() {
    local commands; commands=(
'scan:Scan changed files and classify documentation impact' \
'completion:Print shell completion script' \
    )
    _describe -t commands 'docs-impact commands' commands "$@"
}
(( $+functions[_docs-impact__subcmd__completion_commands] )) ||
_docs-impact__subcmd__completion_commands() {
    local commands; commands=()
    _describe -t commands 'docs-impact completion commands' commands "$@"
}
(( $+functions[_docs-impact__subcmd__scan_commands] )) ||
_docs-impact__subcmd__scan_commands() {
    local commands; commands=()
    _describe -t commands 'docs-impact scan commands' commands "$@"
}

if [ "$funcstack[1]" = "_docs-impact" ]; then
    _docs-impact "$@"
else
    compdef _docs-impact docs-impact
fi
