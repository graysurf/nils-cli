#compdef zsh-kit

autoload -U is-at-least

_zsh-kit() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_zsh-kit_commands" \
"*::: :->zsh-kit" \
&& ret=0
    case $state in
    (zsh-kit)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:zsh-kit-command-$line[1]:"
        case $line[1] in
            (setup)
_arguments "${_arguments_options[@]}" : \
'--repo=[Git repository URL or local path]:URL_OR_PATH:_default' \
'--dest=[Destination directory. Defaults to \$HOME/.config/zsh]:PATH:_files -/' \
'(--ref)--branch=[Branch to checkout after clone/update]:NAME:_default' \
'(--branch)--ref=[Revision, tag, or commit to checkout after clone/update]:REV:_default' \
'*--features=[Comma-separated feature list forwarded to the repo setup hook]:CSV:_default' \
'--install-tools=[Tool-install policy forwarded to the repo setup hook]:INSTALL_TOOLS:(skip repo)' \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'--write-zshenv[Write a managed \$HOME/.zshenv that exports ZDOTDIR and setup features]' \
'--dry-run[Preview intended actions without filesystem, git, bootstrap, or hook mutation]' \
'--apply[Mutate the destination and dispatch the repo setup hook]' \
'--force[Allow guarded overwrite/update paths such as mismatched remotes or .zshenv replacement]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':shell -- Shell to generate completion script for:(bash zsh)' \
&& ret=0
;;
        esac
    ;;
esac
}

(( $+functions[_zsh-kit_commands] )) ||
_zsh-kit_commands() {
    local commands; commands=(
'setup:Clone/update a Zsh repository and dispatch its setup hook' \
'completion:Print shell completion script' \
    )
    _describe -t commands 'zsh-kit commands' commands "$@"
}
(( $+functions[_zsh-kit__subcmd__completion_commands] )) ||
_zsh-kit__subcmd__completion_commands() {
    local commands; commands=()
    _describe -t commands 'zsh-kit completion commands' commands "$@"
}
(( $+functions[_zsh-kit__subcmd__setup_commands] )) ||
_zsh-kit__subcmd__setup_commands() {
    local commands; commands=()
    _describe -t commands 'zsh-kit setup commands' commands "$@"
}

if [ "$funcstack[1]" = "_zsh-kit" ]; then
    _zsh-kit "$@"
else
    compdef _zsh-kit zsh-kit
fi
