&& ret=0
;;
(activity)
_arguments "${_arguments_options[@]}" : \
'--state-dir=[State directory. Defaults to AGENT_SESSION_STATE_DIR, XDG_STATE_HOME/agent-session, or ~/.local/state/agent-session]:PATH:_files -/' \
'--host=[Hostname used in generated ssh attach commands]:HOST:_default' \
'-h[Print help]' \
'--help[Print help]' \
":: :_agent-session__subcmd__activity_commands" \
"*::: :->activity" \
&& ret=0

    case $state in
    (activity)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:agent-session-activity-command-$line[1]:"
        case $line[1] in
            (event)
_arguments "${_arguments_options[@]}" : \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'--state-dir=[State directory. Defaults to AGENT_SESSION_STATE_DIR, XDG_STATE_HOME/agent-session, or ~/.local/state/agent-session]:PATH:_files -/' \
'--host=[Hostname used in generated ssh attach commands]:HOST:_default' \
'--stdin[Read the JSON event from stdin]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':id -- Session id:_default' \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'--state-dir=[State directory. Defaults to AGENT_SESSION_STATE_DIR, XDG_STATE_HOME/agent-session, or ~/.local/state/agent-session]:PATH:_files -/' \
'--host=[Hostname used in generated ssh attach commands]:HOST:_default' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':id -- Session id:_default' \
&& ret=0
;;
(hook)
_arguments "${_arguments_options[@]}" : \
'--agent=[Provider whose hook payload is on stdin]:AGENT:(codex claude hermes)' \
'--event=[Provider event name when the raw payload does not carry one]:EVENT:_default' \
'--state-dir=[State directory. Defaults to AGENT_SESSION_STATE_DIR, XDG_STATE_HOME/agent-session, or ~/.local/state/agent-session]:PATH:_files -/' \
'--host=[Hostname used in generated ssh attach commands]:HOST:_default' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(notify)
_arguments "${_arguments_options[@]}" : \
'--agent=[Provider whose notification payload is supplied as the final argument]:AGENT:(codex claude hermes)' \
'--forward-notify-argv-json=[JSON argv for an existing singular notifier composed by activity setup]:JSON:_default' \
'--state-dir=[State directory. Defaults to AGENT_SESSION_STATE_DIR, XDG_STATE_HOME/agent-session, or ~/.local/state/agent-session]:PATH:_files -/' \
'--host=[Hostname used in generated ssh attach commands]:HOST:_default' \
'-h[Print help]' \
'--help[Print help]' \
':payload -- Provider-authored JSON passed by Codex in argv; content is discarded after parsing but is transiently visible to same-host process inspection:_default' \
&& ret=0
;;
(doctor)
_arguments "${_arguments_options[@]}" : \
'--agent=[Limit diagnostics to one provider]:AGENT:(codex claude hermes)' \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'--state-dir=[State directory. Defaults to AGENT_SESSION_STATE_DIR, XDG_STATE_HOME/agent-session, or ~/.local/state/agent-session]:PATH:_files -/' \
'--host=[Hostname used in generated ssh attach commands]:HOST:_default' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(setup)
_arguments "${_arguments_options[@]}" : \
'--agent=[Provider to configure]:AGENT:(codex claude hermes)' \
'(--dry-run)--expected-preview-digest=[Digest returned by the reviewed Codex repair preview. Required when applying Codex repair and rejected if either planned file changed]:SHA256:_default' \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'--state-dir=[State directory. Defaults to AGENT_SESSION_STATE_DIR, XDG_STATE_HOME/agent-session, or ~/.local/state/agent-session]:PATH:_files -/' \
'--host=[Hostname used in generated ssh attach commands]:HOST:_default' \
'(--apply --remove)--dry-run[Preview a Codex-only repair plan when combined with --repair; otherwise preview the exact additive change without writing it]' \
'(--dry-run --remove --repair)--apply[Apply the additive provider integration]' \
'(--dry-run --apply --repair)--remove[Remove only agent-session-owned provider lifecycle entries, including the exact Codex notify argv]' \
'(--apply --remove)--repair[Restore missing agent-session-owned entries without replacing others]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
        esac
    ;;
esac
;;
(serve)
_arguments "${_arguments_options[@]}" : \
'--bind=[Address to bind. Defaults to loopback; a non-loopback address is refused unless --allow-non-loopback is passed (it exposes a remote shell)]:ADDR:_default' \
'--token=[Bearer token required on activity streaming, write, and attach endpoints. Falls back to AGENT_SESSION_TOKEN. When unset, activity streaming, writes, and attach are disabled (session reads still work on loopback)]:TOKEN:_default' \
'--machine=[Machine identity reported in responses. Falls back to AGENT_SESSION_MACHINE, then --host, then the short hostname]:NAME:_default' \
'--tmux-bin=[tmux binary override]:PATH:_files' \
'--state-dir=[State directory. Defaults to AGENT_SESSION_STATE_DIR, XDG_STATE_HOME/agent-session, or ~/.local/state/agent-session]:PATH:_files -/' \
'--host=[Hostname used in generated ssh attach commands]:HOST:_default' \
'(--token)--token-stdin[Read the bearer token once from stdin instead of process arguments]' \
'--allow-non-loopback[Deliberately allow binding a non-loopback address. Without this, a non-loopback --bind is refused because it exposes a remote shell]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(delete)
_arguments "${_arguments_options[@]}" : \
'--tmux-bin=[tmux binary override]:PATH:_files' \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output (default)"
json\:"Single-record JSON envelope (snake_case)"))' \
'--state-dir=[State directory. Defaults to AGENT_SESSION_STATE_DIR, XDG_STATE_HOME/agent-session, or ~/.local/state/agent-session]:PATH:_files -/' \
'--host=[Hostname used in generated ssh attach commands]:HOST:_default' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':id -- Session id:_default' \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
'--state-dir=[State directory. Defaults to AGENT_SESSION_STATE_DIR, XDG_STATE_HOME/agent-session, or ~/.local/state/agent-session]:PATH:_files -/' \
'--host=[Hostname used in generated ssh attach commands]:HOST:_default' \
'-h[Print help]' \
'--help[Print help]' \
':shell -- Shell to generate completion script for:(bash zsh)' \
&& ret=0
;;
        esac
    ;;
esac
}

(( $+functions[_agent-session_commands] )) ||
_agent-session_commands() {
    local commands; commands=(
'start:Start an interactive tmux-backed agent session' \
'run:Run a one-shot agent task in a tmux session and write output to a log file' \
'list:List recorded agent sessions' \
'command:Print the attach command for a session' \
'attach:Attach to a tmux session from the current terminal' \
'logs:Print captured tmux pane output or a one-shot run log' \
'send:Send input (literal text and/or special keys) to a live session' \
'glance:Capture the recent pane tail plus live status as a dashboard glance' \
'resume:Recreate a missing tmux runtime from exact provider resume metadata' \
'activity:Inspect or ingest metadata-only agent turn lifecycle events' \
'serve:Serve the control plane (HTTP) and PTY attach (WebSocket) over loopback' \
'delete:Delete session state and kill the tmux session if it is still alive' \
'completion:Print shell completion script' \
    )
    _describe -t commands 'agent-session commands' commands "$@"
}
(( $+functions[_agent-session__subcmd__activity_commands] )) ||
_agent-session__subcmd__activity_commands() {
    local commands; commands=(
'event:Ingest one normalized metadata-only lifecycle event from stdin' \
'status:Inspect the durable turn-state snapshot for one session' \
'hook:Translate one provider hook payload into a safe normalized event' \
'notify:Translate one provider notification payload into a safe normalized event' \
'doctor:Report provider support, version, configuration, and repair guidance' \
'setup:Preview or apply additive provider lifecycle configuration' \
    )
    _describe -t commands 'agent-session activity commands' commands "$@"
}
