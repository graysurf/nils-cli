    _describe -t commands 'agent-session glance commands' commands "$@"
}
(( $+functions[_agent-session__subcmd__list_commands] )) ||
_agent-session__subcmd__list_commands() {
    local commands; commands=()
    _describe -t commands 'agent-session list commands' commands "$@"
}
(( $+functions[_agent-session__subcmd__logs_commands] )) ||
_agent-session__subcmd__logs_commands() {
    local commands; commands=()
    _describe -t commands 'agent-session logs commands' commands "$@"
}
(( $+functions[_agent-session__subcmd__run_commands] )) ||
_agent-session__subcmd__run_commands() {
    local commands; commands=()
    _describe -t commands 'agent-session run commands' commands "$@"
}
(( $+functions[_agent-session__subcmd__send_commands] )) ||
_agent-session__subcmd__send_commands() {
    local commands; commands=()
    _describe -t commands 'agent-session send commands' commands "$@"
}
(( $+functions[_agent-session__subcmd__start_commands] )) ||
_agent-session__subcmd__start_commands() {
    local commands; commands=()
    _describe -t commands 'agent-session start commands' commands "$@"
}

if [ "$funcstack[1]" = "_agent-session" ]; then
    _agent-session "$@"
else
    compdef _agent-session agent-session
fi
