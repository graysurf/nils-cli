}
(( $+functions[_secrets__subcmd__help__subcmd__which_commands] )) ||
_secrets__subcmd__help__subcmd__which_commands() {
    local commands; commands=()
    _describe -t commands 'secrets help which commands' commands "$@"
}
(( $+functions[_secrets__subcmd__list_commands] )) ||
_secrets__subcmd__list_commands() {
    local commands; commands=()
    _describe -t commands 'secrets list commands' commands "$@"
}
(( $+functions[_secrets__subcmd__pull_commands] )) ||
_secrets__subcmd__pull_commands() {
    local commands; commands=()
    _describe -t commands 'secrets pull commands' commands "$@"
}
(( $+functions[_secrets__subcmd__which_commands] )) ||
_secrets__subcmd__which_commands() {
    local commands; commands=()
    _describe -t commands 'secrets which commands' commands "$@"
}

if [ "$funcstack[1]" = "_secrets" ]; then
    _secrets "$@"
else
    compdef _secrets secrets
fi
