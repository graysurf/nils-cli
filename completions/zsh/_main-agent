(( $+functions[_main-agent_commands] )) ||
_main-agent_commands() {
    local commands; commands=(
'init:Create or continuity-rebind this Main Agent'\''s durable run' \
'self:Inspect the authenticated Main Agent or worker identity' \
'rehydrate:Recover the authenticated durable objective or assignment capsule' \
'status:Show a bounded status capsule' \
'checkpoint:Record a revision-fenced run or worker checkpoint' \
'worker:Launch and manage interactive worker assignments' \
'collaborate:Add a non-authoritative collaborator relationship' \
'borrow:Add a bounded non-authoritative borrowing relationship' \
'handoff:Transfer primary assignment routing after quiescence checks' \
'adopt:Adopt an orphaned assignment into this Main Agent'\''s run' \
'close:Close this run after all assignments are terminal' \
'completion:Print shell completion script' \
    )
    _describe -t commands 'main-agent commands' commands "$@"
}
