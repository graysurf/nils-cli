# nils-cli bash completion: agent-memory

if [[ -z ${BASH_VERSION-} ]]; then
  return 0 2>/dev/null || exit 0
fi

shopt -s progcomp 2>/dev/null || true

_nils_cli_agent_memory_source_common_bash() {
  declare -F _nils_cli_completion_common_load_dynamic_bash >/dev/null 2>&1 && return 0

  local source_file="${BASH_SOURCE[0]}"
  local script_dir=''
  script_dir="$(cd -- "$(dirname -- "$source_file")" && pwd -P)" || return 1

  local helper_path="${script_dir}/completion-adapter-common.bash"
  [[ -r "$helper_path" ]] || return 1

  # shellcheck source=/dev/null
  source "$helper_path" || return 1

  declare -F _nils_cli_completion_common_load_dynamic_bash >/dev/null 2>&1
}

_NILS_AGENT_MEMORY_BASH_GENERATED_STATE=0

_nils_cli_agent_memory_load_generated_bash() {
  _nils_cli_agent_memory_source_common_bash || return 1

  # agent-memory is completion_engine=dynamic: load the clap_complete
  # `CompleteEnv` registration stub emitted by `agent-memory completion bash` as
  # a generated function (renamed from `_clap_complete_agent_memory`).
  _nils_cli_completion_common_load_dynamic_bash \
    "_NILS_AGENT_MEMORY_BASH_GENERATED_STATE" \
    "_nils_cli_agent_memory_generated" \
    "agent-memory" \
    "_clap_complete_agent_memory"
}

_nils_cli_agent_memory_complete() {
  if ! _nils_cli_agent_memory_load_generated_bash; then
    if declare -F _nils_cli_completion_common_fail_closed_bash >/dev/null 2>&1; then
      _nils_cli_completion_common_fail_closed_bash
    else
      COMPREPLY=()
    fi
    return 0
  fi

  _nils_cli_agent_memory_generated "$1" "$2" "$3"
}

if _nils_cli_agent_memory_source_common_bash; then
  _nils_cli_completion_common_register_bash _nils_cli_agent_memory_complete agent-memory
else
  complete -F _nils_cli_agent_memory_complete agent-memory
fi
