_plan-archive() {
    local i cur prev opts cmd
    COMPREPLY=()
    if [[ "${BASH_VERSINFO[0]}" -ge 4 ]]; then
        cur="$2"
    else
        cur="${COMP_WORDS[COMP_CWORD]}"
    fi
    prev="$3"
    cmd=""
    opts=""

    for i in "${COMP_WORDS[@]:0:COMP_CWORD}"
    do
        case "${cmd},${i}" in
            ",$1")
                cmd="plan__archive"
                ;;
            plan__archive,completion)
                cmd="plan__archive__completion"
                ;;
            plan__archive,help)
                cmd="plan__archive__help"
                ;;
            plan__archive,migrate)
                cmd="plan__archive__migrate"
                ;;
            plan__archive,query)
                cmd="plan__archive__query"
                ;;
            plan__archive,refresh)
                cmd="plan__archive__refresh"
                ;;
            plan__archive,validate-hosts)
                cmd="plan__archive__validate__hosts"
                ;;
            plan__archive,validate-local)
                cmd="plan__archive__validate__local"
                ;;
            plan__archive,validate-metadata)
                cmd="plan__archive__validate__metadata"
                ;;
            plan__archive__help,completion)
                cmd="plan__archive__help__completion"
                ;;
            plan__archive__help,help)
                cmd="plan__archive__help__help"
                ;;
            plan__archive__help,migrate)
