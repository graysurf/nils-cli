    fi
    prev="$3"
    cmd=""
    opts=""

    for i in "${COMP_WORDS[@]:0:COMP_CWORD}"
    do
        case "${cmd},${i}" in
            ",$1")
                cmd="opencode__cli"
                ;;
            opencode__cli,agent)
                cmd="opencode__cli__agent"
                ;;
            opencode__cli,completion)
                cmd="opencode__cli__completion"
                ;;
            opencode__cli,help)
                cmd="opencode__cli__help"
